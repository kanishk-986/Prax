{
  "manifest_version": 3,
  "name": "Prax for LinkedIn",
  "version": "0.9.7",
  "description": "Draft comments, replies and connection notes in your profile's voice right on LinkedIn, and log what you post to Prax. Acts only when you click.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://prax-gamma.vercel.app/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.x.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.perplexity.ai/*",
    "https://serpapi.com/*",
    "https://text.external-api.pangram.com/*",
    "https://api.mistral.ai/*",
    "https://api.deepseek.com/*",
    "https://api.groq.com/*",
    "https://api.exa.ai/*",
    "https://api.tavily.com/*",
    "https://api.firecrawl.dev/*",
    "https://api.gptzero.me/*",
    "https://api.originality.ai/*",
    "https://newsapi.org/*",
    "https://api.apify.com/*",
    "https://api.crunchbase.com/*",
    "https://api.calendly.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Prax",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "dom.js",
        "marks.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://prax-gamma.vercel.app/*"
      ],
      "js": [
        "tools.js",
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://api.walterwrites.ai/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/walter.png"
      ],
      "matches": [
        "https://www.linkedin.com/*"
      ]
    }
  ]
}
